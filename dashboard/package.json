{
  "name": "sabah-lead-dashboard",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc -p functions",
    "build": "npm run typecheck && vite build",
    "preview": "npm run build && wrangler pages dev dist",
    "db:migrate:local": "wrangler d1 migrations apply sabah-leads --local",
    "db:migrate": "wrangler d1 migrations apply sabah-leads --remote"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "wrangler": "^4.0.0"
  }
}
