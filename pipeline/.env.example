# Needed to reach D1. Token scope: Account > D1 > Edit only. Keep this file chmod 600.
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_API_TOKEN=

# API keys: either set them here, or leave them out, set SETTINGS_KEY (same value as the Pages
# secret of the same name) and enter the keys in the dashboard under Settings.
SETTINGS_KEY=
DEEPSEEK_API_KEY=
APIFY_TOKEN=

DEEPSEEK_MODEL=deepseek-v4-pro
SENDER_NAME=Adib
STUDIO_NAME=Smart Native Maker
